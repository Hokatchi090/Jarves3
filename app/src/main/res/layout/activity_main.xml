<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/app_background"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="40sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="جارفس"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="جاهز للاستماع"
            android:textColor="@color/jarvis_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Conversation log card -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/chat_card_background"
        android:padding="20dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp" />
    </ScrollView>

    <!-- Mic button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/micButton"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/mic_button_background"
            android:elevation="12dp"
            android:text="🎙️"
            android:textSize="36sp"
            android:textColor="@color/jarvis_text_primary"
            android:includeFontPadding="false"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="دوس واحكي \"جارفس\" وبعدها الأمر"
        android:textColor="@color/jarvis_text_secondary"
        android:textSize="13sp" />

</LinearLayout>
